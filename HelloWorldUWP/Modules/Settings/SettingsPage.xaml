<Page
    x:Class="HelloWorldUWP.Modules.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,12,16,24" MaxWidth="480" HorizontalAlignment="Stretch">
            <!-- Header Title -->
            <TextBlock x:Name="SettingsTitleText" 
                       Text="Einstellungen &amp; Info" 
                       FontSize="22" 
                       FontWeight="SemiBold" 
                       Margin="0,0,0,16"/>

            <!-- Language Selection Card -->
            <Border Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" 
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    Padding="16" 
                    Margin="0,0,0,16" 
                    CornerRadius="8">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Globe Icon -->
                        <Border Grid.Column="0" 
                                Width="36" 
                                Height="36" 
                                CornerRadius="18" 
                                Background="{ThemeResource SystemControlHighlightAccentBrush}" 
                                Margin="0,0,12,0">
                            <FontIcon FontFamily="Segoe MDL2 Assets" 
                                      Glyph="&#xE774;" 
                                      FontSize="18" 
                                      Foreground="#FFFFFF" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="LanguageHeaderText" 
                                       Text="Sprache / Language" 
                                       FontSize="16" 
                                       FontWeight="SemiBold" 
                                       Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                            <TextBlock x:Name="LanguageDescText" 
                                       Text="Wählen Sie die Anzeigesprache für die App." 
                                       FontSize="12" 
                                       TextWrapping="Wrap" 
                                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Language Radio Selectors -->
                    <StackPanel Margin="48,4,0,0">
                        <RadioButton x:Name="RadioGerman" 
                                     Content="Deutsch (German)" 
                                     GroupName="AppLanguageGroup" 
                                     Margin="0,0,0,6"
                                     Click="RadioGerman_Click"/>
                        <RadioButton x:Name="RadioEnglish" 
                                     Content="English" 
                                     GroupName="AppLanguageGroup" 
                                     Click="RadioEnglish_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- App info card -->
            <Border Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" 
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    Padding="16" 
                    Margin="0,0,0,16" 
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock x:Name="AppInfoHeaderText" 
                               Text="Saarland Uni" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="AppInfoVersionText" 
                               Text="Version 1.0 (Windows 10 Mobile Edition)" 
                               FontSize="12" 
                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" 
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="AppInfoDescText" 
                               Text="Inoffizielle App für Studierende und Beschäftigte der Universität des Saarlandes (UdS). Unterstützt Windows 10 Mobile Geräte." 
                               TextWrapping="Wrap" 
                               FontSize="13" 
                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>
            </Border>

            <!-- Data source card -->
            <Border Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" 
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    Padding="16" 
                    Margin="0,0,0,16" 
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock x:Name="DataSourcesHeaderText" 
                               Text="Datenquellen" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="DataSourcesDescText" 
                               Text="Mensa-Speisepläne werden über die offizielle OpenMensa API v2 (openmensa.org) und das Studierendenwerk Saarland (mensaar.de) bezogen. Fahrplandaten stammen von Transitous / MOTIS 2." 
                               TextWrapping="Wrap" 
                               FontSize="13" 
                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                </StackPanel>
            </Border>

            <!-- Offline Cache management -->
            <Border Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" 
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    Padding="16" 
                    Margin="0,0,0,16" 
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock x:Name="CacheHeaderText" 
                               Text="Offline-Speicher" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="CacheDescText" 
                               Text="Speisepläne und Fahrplandaten werden lokal auf dem Telefon zwischengespeichert, damit Sie sie auch ohne Empfang im Hörsaal einsehen können." 
                               TextWrapping="Wrap" 
                               FontSize="13" 
                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" 
                               Margin="0,0,0,12"/>
                    <Button x:Name="ClearCacheButton" 
                            Content="Cache jetzt leeren" 
                            Click="ClearCacheButton_Click" 
                            HorizontalAlignment="Left"/>
                    <TextBlock x:Name="CacheStatusText" 
                               Text="" 
                               Margin="0,8,0,0" 
                               FontSize="12" 
                               Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
