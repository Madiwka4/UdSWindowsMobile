<Page
    x:Class="HelloWorldUWP.Modules.Card.Views.CardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HelloWorldUWP.Modules.Card.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="16,16,16,24" MaxWidth="440" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <!-- Title Header -->
                <RowDefinition Height="Auto" />
                <!-- Virtual Card Visual -->
                <RowDefinition Height="Auto" />
                <!-- NFC Status & Instructions -->
                <RowDefinition Height="Auto" />
                <!-- Actions -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="CardHeaderTitleText"
                           Text="Mensa Card Balance"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                <TextBlock x:Name="CardHeaderSubtitleText"
                           Text="Offline NFC Reader • Universität des Saarlandes"
                           FontSize="12"
                           Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
            </StackPanel>

            <!-- Virtual Card Visual (Realistic UdS-Card) -->
            <Border Grid.Row="1"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="#1A3A5F"
                    Height="210"
                    Margin="0,0,0,18"
                    HorizontalAlignment="Stretch">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#001833" Offset="0.0" />
                        <GradientStop Color="#002D5A" Offset="0.6" />
                        <GradientStop Color="#004080" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid Padding="18">
                    <Grid.RowDefinitions>
                        <!-- Card Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Balance Body -->
                        <RowDefinition Height="*" />
                        <!-- Card Footer -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Background Owl Watermark -->
                    <Image Grid.RowSpan="3"
                           Source="ms-appx:///Assets/owl_white.png"
                           Opacity="0.12"
                           Width="150"
                           Height="160"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,0,-10,-10"
                           Stretch="Uniform" />

                    <!-- Top Card Row: Chip graphic & Institution Name -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Gold Smart Chip Graphic -->
                        <Border Grid.Column="0"
                                Width="36"
                                Height="26"
                                CornerRadius="4"
                                Background="#E5B23A"
                                BorderBrush="#C69420"
                                BorderThickness="1"
                                Margin="0,0,12,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="UdS-Card"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF" />
                            <TextBlock Text="Universität des Saarlandes"
                                       FontSize="10"
                                       Foreground="#A0C8F0" />
                        </StackPanel>

                        <!-- Contactless NFC Wave Symbol -->
                        <FontIcon Grid.Column="2"
                                  FontFamily="Segoe MDL2 Assets"
                                  Glyph="&#xE8A1;"
                                  FontSize="20"
                                  Foreground="#A0C8F0"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <!-- Middle Card Row: Balance Display -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock x:Name="CurrentBalanceLabelText"
                                   Text="CURRENT BALANCE"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#90B8E0"
                                   CharacterSpacing="120"
                                   Margin="0,0,0,2" />
                        <TextBlock x:Name="BalanceAmountText"
                                   Text="--,-- €"
                                   FontSize="38"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF" />
                    </StackPanel>

                    <!-- Bottom Card Row: System Info & Read Time -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="InstitutionFooterText"
                                       Text="Studierendenwerk Saarland"
                                       FontSize="10"
                                       Foreground="#A0C8F0" />
                            <TextBlock x:Name="CardTypeFooterText"
                                       Text="MIFARE DESFire EV1 (InterCard)"
                                       FontSize="9"
                                       Foreground="#7098C0" />
                        </StackPanel>

                        <TextBlock x:Name="LastReadTimeText"
                                   Grid.Column="1"
                                   Text="Tap card to read"
                                   FontSize="10"
                                   Foreground="#A0C8F0"
                                   VerticalAlignment="Bottom" />
                    </Grid>
                </Grid>
            </Border>

            <!-- NFC Status & Instructions Card -->
            <Border Grid.Row="2"
                    Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Pulse/NFC Icon -->
                        <Border Grid.Column="0"
                                Width="36"
                                Height="36"
                                CornerRadius="18"
                                Background="{ThemeResource SystemControlHighlightAccentBrush}"
                                Margin="0,0,12,0">
                            <FontIcon FontFamily="Segoe MDL2 Assets"
                                      Glyph="&#xE8C7;"
                                      FontSize="18"
                                      Foreground="#FFFFFF"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="NfcSectionTitleText"
                                       Text="Offline NFC Reader"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                            <TextBlock x:Name="NfcStatusDescriptionText"
                                       Text="Hold your UdS-Card against the back of your phone."
                                       FontSize="11"
                                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!-- Realtime Status Line with Dot -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StatusDot"
                                 Grid.Column="0"
                                 Width="8"
                                 Height="8"
                                 Fill="#107C41"
                                 Margin="4,0,8,0"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusMessageText"
                                   Grid.Column="1"
                                   Text="NFC Reader is active and listening..."
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Reset / Clear Cache Action -->
            <Button x:Name="ClearButton"
                    Grid.Row="3"
                    Click="ClearButton_Click"
                    HorizontalAlignment="Center"
                    Padding="16,8,16,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <FontIcon FontFamily="Segoe MDL2 Assets"
                              Glyph="&#xE74D;"
                              FontSize="13"
                              Margin="0,0,8,0" />
                    <TextBlock x:Name="ClearButtonText"
                               Text="Clear Card"
                               FontSize="12"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>
    </ScrollViewer>
</Page>
