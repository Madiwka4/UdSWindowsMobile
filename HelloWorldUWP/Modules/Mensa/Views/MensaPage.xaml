<Page
    x:Class="HelloWorldUWP.Modules.Mensa.Views.MensaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:HelloWorldUWP.Modules.Mensa.Models"
    xmlns:converters="using:HelloWorldUWP.Modules.Mensa.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:CategoryToBackgroundConverter x:Key="CategoryToBgConverter"/>
        <converters:CategoryToForegroundConverter x:Key="CategoryToFgConverter"/>
        <converters:CategoryToAccentConverter x:Key="CategoryToAccentConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Selectors -->
            <RowDefinition Height="Auto"/>
            <!-- Offline/Cache notice -->
            <RowDefinition Height="Auto"/>
            <!-- Content / List -->
            <RowDefinition Height="*"/>
            <!-- Bottom CommandBar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Selectors (Canteen & Day) -->
        <Border Grid.Row="0" 
                Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" 
                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="12,10,12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Canteen Picker -->
                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock Text="Mensa" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Margin="2,0,0,2"/>
                    <ComboBox x:Name="CanteenComboBox" 
                              HorizontalAlignment="Stretch" 
                              SelectionChanged="CanteenComboBox_SelectionChanged"/>
                </StackPanel>

                <!-- Day Picker -->
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <TextBlock Text="Tag" FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Margin="2,0,0,2"/>
                    <ComboBox x:Name="DayComboBox" 
                              HorizontalAlignment="Stretch" 
                              SelectionChanged="DayComboBox_SelectionChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Offline / Cache Banner -->
        <Border x:Name="OfflineBanner" Grid.Row="1" 
                Background="#330078D7" 
                Padding="12,6,12,6" 
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE898;" FontSize="13" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="Offline-Daten geladen" FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <!-- Loading Indicator -->
            <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="44" Height="44" Margin="0,0,0,12"/>
                <TextBlock Text="Speiseplan wird geladen..." FontSize="14" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
            </StackPanel>

            <!-- Closed / Empty State -->
            <StackPanel x:Name="ClosedPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Visibility="Collapsed">
                <FontIcon Glyph="&#xE7BE;" FontSize="48" Margin="0,0,0,12" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                <TextBlock x:Name="ClosedStatusTitle" Text="Mensa geschlossen" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock x:Name="ClosedStatusMessage" 
                           Text="Für diesen Tag sind keine Speiseplandaten verfügbar oder die Mensa hat geschlossen." 
                           FontSize="13" TextWrapping="Wrap" TextAlignment="Center" 
                           Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Margin="0,0,0,16"/>
                <Button x:Name="NextOpenDayButton" Content="Nächsten geöffneten Tag anzeigen" Click="NextOpenDayButton_Click" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Error State -->
            <StackPanel x:Name="ErrorPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Visibility="Collapsed">
                <FontIcon Glyph="&#xEB55;" FontSize="48" Margin="0,0,0,12" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
                <TextBlock Text="Verbindungsfehler" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock x:Name="ErrorMessageText" Text="Daten konnten nicht geladen werden." FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" Margin="0,0,0,16"/>
                <Button Content="Erneut versuchen" Click="ReloadButton_Click" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Meals List -->
            <ListView x:Name="MealsListView" 
                      Padding="12,12,12,12" 
                      SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0,0,0,10"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" 
                                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Padding="12,10,12,10">
                            <StackPanel>
                                <!-- Category & Student Price Header -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Category Pill -->
                                    <Border Grid.Column="0" 
                                            HorizontalAlignment="Left"
                                            Background="{Binding Category, Converter={StaticResource CategoryToBgConverter}}" 
                                            CornerRadius="3" 
                                            Padding="7,2,7,2">
                                        <TextBlock Text="{Binding Category}" 
                                                   FontSize="12" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{Binding Category, Converter={StaticResource CategoryToFgConverter}}"/>
                                    </Border>

                                    <!-- Price -->
                                    <Border Grid.Column="1" 
                                            Visibility="{Binding PriceVisibility}"
                                            Background="{ThemeResource SystemControlBackgroundAltMediumLowBrush}" 
                                            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="3" 
                                            Padding="8,2,8,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Stud. " FontSize="11" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                            <TextBlock Text="{Binding FormattedPrice}" FontSize="13" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Meal Title -->
                                <TextBlock Text="{Binding Name}" 
                                           FontSize="15" 
                                           FontWeight="SemiBold" 
                                           TextWrapping="Wrap" 
                                           Margin="0,0,0,6"/>

                                <!-- Location & Time (Counter) -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Location}" FontSize="12" FontWeight="SemiBold" 
                                               Foreground="{Binding Category, Converter={StaticResource CategoryToAccentConverter}}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding TimeSlot}" FontSize="12" 
                                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                                </StackPanel>

                                <!-- Dietary Badges -->
                                <ItemsControl ItemsSource="{Binding Badges}" Margin="0,2,0,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#2200A0E2" 
                                                    BorderBrush="#5500A0E2" 
                                                    BorderThickness="1" 
                                                    CornerRadius="2" 
                                                    Padding="5,1,5,1" 
                                                    Margin="0,0,6,0">
                                                <TextBlock Text="{Binding}" FontSize="11" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Side dishes / Details -->
                                <TextBlock Text="{Binding SidesText}" 
                                           FontSize="12" 
                                           TextWrapping="Wrap" 
                                           Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" 
                                           Margin="0,4,0,2"/>

                                <!-- Allergens -->
                                <TextBlock Text="{Binding AllergensText}" 
                                           FontSize="10" 
                                           TextWrapping="Wrap" 
                                           Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" 
                                           Margin="0,4,0,0" 
                                           Opacity="0.75"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Bottom CommandBar with Refresh button -->
        <CommandBar Grid.Row="3" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
            <AppBarButton Icon="Refresh" Label="Aktualisieren" Click="ReloadButton_Click"/>
        </CommandBar>
    </Grid>
</Page>
